{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/grounded-legal-answer-generation/compact-output.schema.json",
  "title": "S3 compact raw transport",
  "oneOf": [
    {
      "$ref": "#/$defs/claim_success"
    },
    {
      "$ref": "#/$defs/question_only_success"
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "text",
        "claim_type",
        "applicability",
        "answer_target_ids",
        "citation_required",
        "public_role"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "claim_type": {
          "enum": [
            "legal_rule",
            "application",
            "exception",
            "procedure",
            "remedy"
          ]
        },
        "applicability": {
          "enum": [
            "direct",
            "conditional"
          ]
        },
        "answer_target_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "public_material_condition_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^E[1-9][0-9]*-R[1-9][0-9]*-M[1-9][0-9]*$"
          },
          "uniqueItems": true
        },
        "citation_required": {
          "const": true
        },
        "public_role": {
          "enum": [
            "conclusion",
            "audit"
          ]
        }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "provision_id",
        "support_description"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "provision_id": {
          "type": "string",
          "minLength": 1
        },
        "support_description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "claim_success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "skill_id",
        "mode",
        "status",
        "claims",
        "claim_citations",
        "assumptions",
        "limitations"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "skill_id": {
          "const": "S3"
        },
        "mode": {
          "enum": [
            "GENERATE_ANSWER",
            "GENERATE_BENCHMARK_CANDIDATE"
          ]
        },
        "status": {
          "const": "ok"
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "claim_citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/note"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/note"
          }
        }
      }
    },
    "question_only_success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "skill_id",
        "mode",
        "status",
        "answer",
        "claims",
        "claim_citations",
        "assumptions",
        "limitations"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "skill_id": {
          "const": "S3"
        },
        "mode": {
          "const": "GENERATE_BENCHMARK_CANDIDATE"
        },
        "status": {
          "const": "ok"
        },
        "answer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "claims": {
          "type": "array",
          "maxItems": 0
        },
        "claim_citations": {
          "type": "array",
          "maxItems": 0
        },
        "assumptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/note"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/note"
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "skill_id",
        "mode",
        "status",
        "error"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "skill_id": {
          "const": "S3"
        },
        "mode": {
          "enum": [
            "GENERATE_ANSWER",
            "GENERATE_BENCHMARK_CANDIDATE"
          ]
        },
        "status": {
          "const": "error"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "details"
          ],
          "properties": {
            "code": {
              "enum": [
                "INVALID_INPUT",
                "GENERATION_NOT_AUTHORIZED",
                "UNCOVERED_CRITICAL_EVIDENCE",
                "CONTRACT_UNSATISFIABLE"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "details": {
              "type": "array"
            }
          }
        }
      }
    }
  }
}
